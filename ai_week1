def play_game():
    global human_wins
    global computer_wins
    global draws
    global total_path_cost

    board = [
        "O", " ", "X",
        "X", " ", " ",
        "X", "O", "O"
    ]

    path_cost = 0

    print("\nInitial Board:")
    display_board(board)

    while True:
        print("Human Turn (X)")
        human_turn(board)
        path_cost += 1

        display_board(board)

        if check_winner(board, "X"):
            print("Human Wins!")
            human_wins += 1
            break

        if board_full(board):
            print("Draw!")
            draws += 1
            break

        print("Computer Turn (O)")
        computer_turn(board)
        path_cost += 1

        display_board(board)

        if check_winner(board, "O"):
            print("Computer Wins!")
            computer_wins += 1
            break

        if board_full(board):
            print("Draw!")
            draws += 1
            break

    total_path_cost += path_cost

    print("\nPath Cost:", path_cost)
    display_statistics()


def main():
    while True:
        play_game()

        choice = input("\nPlay again? (y/n): ").lower()

        if choice != "y":
            print("\nFinal Statistics:")
            display_statistics()
            break


if __name__ == "__main__":
    main()
     
